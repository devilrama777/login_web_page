# Flask Core Configuration
SECRET_KEY=mfa-super-secret-production-key-2026-secure
APP_NAME=SecureAuth MFA
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=False

# MFA Settings
OTP_EXPIRY_SECONDS=300
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MAX_OTP_ATTEMPTS=3

# -------------------------------------------------------------
# OPTION A: Free Instant Email API (Recommended for Vercel)
# -------------------------------------------------------------
# 1. Sign up for free at https://resend.com
# 2. Copy your API Key (e.g., re_123456789)
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# -------------------------------------------------------------
# OPTION B: Gmail SMTP (Recommended for Local / Standard Hosting)
# -------------------------------------------------------------
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a 16-character App Password
# 3. Enter your Gmail and App Password below
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
